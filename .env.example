# Copy to .env and fill in real values.

DJANGO_SECRET_KEY=changeme-generate-a-long-random-string
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Local SQLite by default (see config/settings/local.py).
# Production example:
# DATABASE_URL=postgres://overpick:changeme@db:5432/overpick
DATABASE_URL=

# API-Football (https://www.api-football.com/)
API_FOOTBALL_KEY=changeme
# Optional override (tests / proxies):
# API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io

# Model defaults
MODEL_N=5
SIGNAL_THRESHOLD_O15=0.82
SIGNAL_THRESHOLD_O25=0.60
SIGNAL_THRESHOLD_O35=0.42
