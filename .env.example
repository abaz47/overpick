# Copy to .env and fill in real values.

DJANGO_SECRET_KEY=changeme-generate-a-long-random-string
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Local SQLite by default (see config/settings/local.py).
# Production example:
# DATABASE_URL=postgres://overpick:changeme@db:5432/overpick
DATABASE_URL=

# API-Football (https://www.api-football.com/)
API_FOOTBALL_KEY=changeme
# Optional override (tests / proxies):
# API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io

# Model defaults (poisson_v4)
MODEL_N=5
MODEL_MIN_N=3
MODEL_SHRINK_K=3
MODEL_LAST_WEIGHT=0.6
MODEL_DECAY_HALFLIFE_DAYS=90
MODEL_DC_RHO=-0.1
MODEL_INDEX_MIN=0.6
MODEL_INDEX_MAX=1.5
MODEL_LAMBDA_SIDE_MAX=2.8
MODEL_LAMBDA_TOTAL_MAX=5.0
PREDICTION_HORIZON_DAYS=3
# Single Pick tier (tight)
SIGNAL_THRESHOLD_O15=0.88
SIGNAL_THRESHOLD_O25=0.65
SIGNAL_THRESHOLD_O35=0.55
SIGNAL_O35_MAX_PROB=0.70
# Soft launch (Today's picks from this MSK time)
SITE_LAUNCH_AT=2026-10-24T18:00:00
# History won/picked storage from (Europe/Moscow)
STATS_SINCE=2026-10-25T00:00:00
API_FOOTBALL_MIN_INTERVAL=0.5
